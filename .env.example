# ========= 群组服公共环境变量 =========
# 运行时若无 .env，执行 ./mcnet.sh up 会自动生成。
# 也可手动复制本文件: cp .env.example .env

# GHCR 镜像所属组织/用户名 (小写)
# 不填默认使用 abwuge
GHCR_OWNER=abwuge
IMAGE_TAG=latest

# Velocity 与子服共用的 modern forwarding 密钥
# 不填会由 ./mcnet.sh init 自动生成随机密钥 (openssl rand -hex 24)
VELOCITY_FORWARDING_SECRET=change-me-to-random-hex

# RCON (子服内部使用, 仅在 docker 内网暴露)
# 不填会由 ./mcnet.sh init 自动生成随机密码 (openssl rand -hex 16)
RCON_PASSWORD=change-me-rcon

# Java 认证模式；基岩版始终使用 Xbox/Floodgate，无需绑定 Java
ONLINE_MODE=true
# 在线默认开启，离线默认关闭；可通过 whitelist on/off 单独调整
WHITE_LIST=true

# JVM 内存
MAIN_XMS=2G
MAIN_XMX=6G
MIRROR_XMS=1G
MIRROR_XMX=3G
CREATE_XMS=1G
CREATE_XMX=3G
PROXY_XMS=512M
PROXY_XMX=1G

# 对外端口 (仅 proxy 暴露)
PROXY_PORT=25565
# Geyser Bedrock 端口 (UDP)
BEDROCK_PORT=19132

# MOTD (Velocity 3.3+ uses MiniMessage, not legacy § codes)
MOTD_PROXY=<green>生电群组服</green> <gray>|</gray> <aqua>main</aqua> <gray>+</gray> <yellow>mirror</yellow> <gray>+</gray> <light_purple>create</light_purple>

# Caddy 将面板与守护进程统一到宿主机 80/443；面板端口仅在 Docker 网络内使用。
# 公网网页地址，例如 https://mcsm.example.com
MCSM_PUBLIC_URL=
# 未使用公网反代时，init 自动填写宿主机 IP
MCSM_NODE_ADDRESS=
# 首次启动自动创建管理员；留空密码会随机生成并保存到面板数据目录
MCSM_ADMIN_USER=admin
# 自定义密码需 9–36 位，包含大小写字母和数字
MCSM_ADMIN_PASSWORD=
