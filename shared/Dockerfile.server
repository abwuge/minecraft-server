# Subserver image (survival/creative differ only by SERVER_NAME).
# FROM the self-built base image which already carries Azul Zulu JDK 25 + MCDR + Fabric launcher + mods.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG SERVER_NAME
WORKDIR /data

# 共享脚本
COPY --link --chmod=755 shared/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --link scripts/mcnet-runtime.py /opt/mcnet/runtime.py

# Per-subserver config templates (mods are inherited from the base image)
COPY --link config/${SERVER_NAME} /opt/server/templates

ENV SERVER_NAME=${SERVER_NAME}

EXPOSE 25565
CMD ["/usr/local/bin/entrypoint.sh"]
